# Copy to .env for local development. Never commit a filled-in copy.
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://bonsai_swarm:CHANGE_ME@127.0.0.1:5432/bonsai_swarm
# openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Optional: Google sign-in. Leave empty to offer username + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: shared secret that unlocks the mock provider and the slow-GPU admission
# override used by the automated tests. Leave empty to disable test mode completely.
TEST_MODE_KEY=

# Points economy (defaults shown)
COINS_WELCOME=1000
COINS_PROVIDE_PER_MINUTE=2
COINS_SERVE_PER_TOKEN=0.5
COINS_CONSUME_PROMPT_PER_TOKEN=0.1
COINS_CONSUME_COMPLETION_PER_TOKEN=0.5

# Admission bar for volunteer GPUs, in decoded tokens per second
PROVIDER_MIN_DECODE_TPS=10

# Optional supply-chain pin for the WebGPU runtime lifted from the Hugging Face space.
# Read the full sha from /api/stats once you trust the current copy.
RUNTIME_SHA256=

# ---------------------------------------------------------------- free fallback
# What answers when the swarm is empty. Leave everything here unset to run a purely
# peer-to-peer network: a request with nobody online then waits and expires, as before.
#
# Any OpenAI-compatible endpoint works. Either one upstream:
#   FALLBACK_BASE_URL=https://example.com/v1
#   FALLBACK_MODEL=some/free-model
#   FALLBACK_API_KEY=...            # server-side only; never commit a filled-in copy
#   FALLBACK_LABEL=Some Free Model  # what the visitor is told answered; defaults to the model id
#   FALLBACK_NO_THINKING=1          # ask reasoning models not to think (they otherwise
#                                   # spend the whole token budget on it and answer nothing)
# ...or a list, tried in order, as JSON. Use "apiKeyEnv" to name another variable to read
# the key from, so the structural config stays free of secrets and can be edited safely:
#   PROVIDER_A_KEY=...
#   FALLBACK_UPSTREAMS=[{"label":"Model A","baseUrl":"https://a.example/v1","model":"a/model","apiKeyEnv":"PROVIDER_A_KEY"},
#                       {"label":"Model B","baseUrl":"https://b.example/v1","model":"b/model","apiKey":"inline-also-works"}]
FALLBACK_ENABLED=1
# Seconds a job waits for a volunteer before the fallback takes it. With nobody admitted
# in the network at all, the fallback starts immediately instead.
FALLBACK_QUEUE_WAIT_MS=20000
FALLBACK_MAX_NEW_TOKENS=512
# Flat AI Coins per fallback answer, whatever its length. No volunteer is paid for it.
COINS_FALLBACK_FLAT=5
# The fallback costs real money, so it is rationed three ways.
FALLBACK_PER_ACCOUNT_PER_HOUR=20
FALLBACK_PER_IP_PER_HOUR=30
FALLBACK_GLOBAL_PER_DAY=500
FALLBACK_TIMEOUT_MS=90000
FALLBACK_FIRST_TOKEN_MS=30000
